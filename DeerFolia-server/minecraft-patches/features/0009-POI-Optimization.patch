-            int sectionsToVillage = poiManager.sectionsToVillage(SectionPos.of(body.blockPosition()));
+            int sectionsToVillage = getCachedSectionsToVillage(poiManager, SectionPos.of(body.blockPosition()), timestamp); // DeerFolia - POI optimization
             Vec3 targetPos = null;
 
