                 if (landPos != null) {
-                    int landPosSectionsToVillage = poiManager.sectionsToVillage(SectionPos.of(BlockPos.containing(landPos)));
+                    int landPosSectionsToVillage = getCachedSectionsToVillage(poiManager, SectionPos.of(BlockPos.containing(landPos)), timestamp); // DeerFolia - POI optimization
                     if (landPosSectionsToVillage < sectionsToVillage) {
                         targetPos = landPos;
                         break;
