@@ -419,6 +419,67 @@ public final class RegionizedPlayerChunkLoader {
             this.player = player;
         }
 
+        public long[] deerFolia$snapshotSentChunks() { // DeerFolia - AFK network optimization
+            TickThread.ensureTickThread("Cannot snapshot player chunks async");
+            return this.sentChunks.toLongArray();
+        }
+
+        public void deerFolia$resyncClientChunks(final long[] previousClientChunks, final boolean resendCurrent) { // DeerFolia - AFK network optimization
+            TickThread.ensureTickThread("Cannot resync player chunks async");
+
+            final LongOpenHashSet previous = new LongOpenHashSet(previousClientChunks);
+            for (final long chunkKey : previous) {
+                if (!this.sentChunks.contains(chunkKey)) {
+                    this.player.connection.send(new ClientboundForgetLevelChunkPacket(new ChunkPos(
+                        CoordinateUtils.getChunkX(chunkKey), CoordinateUtils.getChunkZ(chunkKey)
+                    )));
+                }
+            }
+
+            final LongArrayList chunksToSend = new LongArrayList();
+            for (final long chunkKey : this.sentChunks) {
+                if (resendCurrent || !previous.contains(chunkKey)) {
+                    chunksToSend.add(chunkKey);
+                }
+            }
+            this.deerFolia$resendClientChunks(chunksToSend.toLongArray());
+        }
+
+        public void deerFolia$resendClientChunks(final long[] chunkKeys) { // DeerFolia - AFK network optimization
+            TickThread.ensureTickThread("Cannot resend player chunks async");
+            if (chunkKeys.length == 0) {
+                return;
+            }
+
+            final LongOpenHashSet uniqueChunkKeys = new LongOpenHashSet(chunkKeys);
+            final LongArrayList loadedChunkKeys = new LongArrayList();
+            for (final long chunkKey : uniqueChunkKeys) {
+                if (!this.sentChunks.contains(chunkKey)) {
+                    continue;
+                }
+                final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+                final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+                final LevelChunk chunk = ((ChunkSystemLevel)this.world).moonrise$getFullChunkIfLoaded(chunkX, chunkZ);
+                if (chunk != null) {
+                    loadedChunkKeys.add(chunkKey);
+                }
+            }
+            if (loadedChunkKeys.isEmpty()) {
+                return;
+            }
+
+            this.player.connection.send(net.minecraft.network.protocol.game.ClientboundChunkBatchStartPacket.INSTANCE);
+            for (final long chunkKey : loadedChunkKeys) {
+                final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+                final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+                final LevelChunk chunk = ((ChunkSystemLevel)this.world).moonrise$getFullChunkIfLoaded(chunkX, chunkZ);
+                if (chunk != null) {
+                    PlayerChunkSender.deerFolia$resendChunkPacketOnly(this.player.connection, this.world, chunk);
+                }
+            }
+            this.player.connection.send(new net.minecraft.network.protocol.game.ClientboundChunkBatchFinishedPacket(loadedChunkKeys.size()));
+        }
+
