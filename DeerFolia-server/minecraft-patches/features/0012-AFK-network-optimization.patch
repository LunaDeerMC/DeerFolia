@@ -439,6 +450,14 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             return;
         }
 
+        // DeerFolia start - suppress non-essential AFK packets
+        final net.minecraft.server.level.ServerPlayer deerFoliaPlayer = this.getPlayer();
+        if (deerFoliaPlayer != null && cn.lunadeer.mc.deerfolia.afknetwork.AfkNetworkManager.shouldSuppress(deerFoliaPlayer, packet, this)) {
+            packet.onPacketDispatchFinish(deerFoliaPlayer, null);
+            return;
+        }
+        // DeerFolia end - suppress non-essential AFK packets
+
         packet.onPacketDispatch(this.getPlayer());
