@@ -5754,18 +5768,44 @@ public abstract class Entity
 
     private Stream<Entity> getIndirectPassengersStream() {
         if (this.passengers.isEmpty()) { return Stream.of(); } // Paper - Optimize indirect passenger iteration
+        // DeerFolia start - Lithium: avoid recursive stream allocations
+        if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+            && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.allocations) {
+            List<Entity> indirectPassengers = new ArrayList<>();
+            collectIndirectPassengers(indirectPassengers, this.passengers);
+            return indirectPassengers.stream();
+        }
+        // DeerFolia end - Lithium: avoid recursive stream allocations
         return this.passengers.stream().flatMap(Entity::getSelfAndPassengers);
     }
 
     @Override
     public Stream<Entity> getSelfAndPassengers() {
         if (this.passengers.isEmpty()) { return Stream.of(this); } // Paper - Optimize indirect passenger iteration
+        // DeerFolia start - Lithium: avoid recursive stream allocations
+        if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+            && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.allocations) {
+            List<Entity> selfAndPassengers = new ArrayList<>();
+            selfAndPassengers.add(this);
+            collectIndirectPassengers(selfAndPassengers, this.passengers);
+            return selfAndPassengers.stream();
+        }
+        // DeerFolia end - Lithium: avoid recursive stream allocations
         return Stream.concat(Stream.of(this), this.getIndirectPassengersStream());
     }
 
     @Override
     public Stream<Entity> getPassengersAndSelf() {
         if (this.passengers.isEmpty()) { return Stream.of(this); } // Paper - Optimize indirect passenger iteration
+        // DeerFolia start - Lithium: avoid recursive stream allocations
+        if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+            && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.allocations) {
+            List<Entity> passengersAndSelf = new ArrayList<>();
+            collectIndirectPassengersDepthFirst(passengersAndSelf, this.passengers);
+            passengersAndSelf.add(this);
+            return passengersAndSelf.stream();
+        }
+        // DeerFolia end - Lithium: avoid recursive stream allocations
         return Stream.concat(this.passengers.stream().flatMap(Entity::getPassengersAndSelf), Stream.of(this));
     }
 
