     protected void tryAddFrost() {
+        // DeerFolia start - Lithium: delay the block lookup until an entity is actually frozen
+        if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+            && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.entity) {
+            int ticksFrozen = this.getTicksFrozen();
+            if (ticksFrozen > 0 && !this.getBlockStateOnLegacy().isAir()) {
+                AttributeInstance speed = this.getAttribute(Attributes.MOVEMENT_SPEED);
+                if (speed == null) {
+                    return;
+                }
+
+                float slowAmount = -0.05F * this.getPercentFrozen();
+                speed.addTransientModifier(new AttributeModifier(SPEED_MODIFIER_POWDER_SNOW_ID, slowAmount, AttributeModifier.Operation.ADD_VALUE));
+            }
+            return;
+        }
+        // DeerFolia end - Lithium: delay the block lookup until an entity is actually frozen
         if (!this.getBlockStateOnLegacy().isAir()) {
             int ticksFrozen = this.getTicksFrozen();
             if (ticksFrozen > 0) {
@@ -3867,6 +3883,13 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
