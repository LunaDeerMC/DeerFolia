diff --git a/net/minecraft/core/AxisCycle.java b/net/minecraft/core/AxisCycle.java
index e3524e706e02683d891a8de1e552a0bd0595b0f4..9fc5c9a1831e50ea2932e274da8bf130d4ef9747 100644
--- a/net/minecraft/core/AxisCycle.java
+++ b/net/minecraft/core/AxisCycle.java
@@ -35,6 +35,17 @@ public enum AxisCycle {
 
         @Override
         public Direction.Axis cycle(final Direction.Axis axis) {
+            // DeerFolia start - Lithium: avoid modulo and array lookup
+            if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+                && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.math) {
+                return switch (axis.ordinal()) {
+                    case 0 -> Direction.Axis.Y;
+                    case 1 -> Direction.Axis.Z;
+                    case 2 -> Direction.Axis.X;
+                    default -> throw new IllegalArgumentException("Unknown axis: " + axis);
+                };
+            }
+            // DeerFolia end - Lithium: avoid modulo and array lookup
             return AXIS_VALUES[Math.floorMod(axis.ordinal() + 1, 3)];
         }
 
@@ -56,6 +67,17 @@ public enum AxisCycle {
 
         @Override
         public Direction.Axis cycle(final Direction.Axis axis) {
+            // DeerFolia start - Lithium: avoid modulo and array lookup
+            if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+                && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.math) {
+                return switch (axis.ordinal()) {
+                    case 0 -> Direction.Axis.Z;
+                    case 1 -> Direction.Axis.X;
+                    case 2 -> Direction.Axis.Y;
