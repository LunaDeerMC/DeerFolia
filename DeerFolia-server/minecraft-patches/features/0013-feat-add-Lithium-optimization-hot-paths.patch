         this.checkFallDistanceAccumulation();
         if (!this.level().isClientSide()) {
+            // DeerFolia start - Lithium: skip glide equipment checks for grounded entities
+            if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+                && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.entity
+                && !this.isFallFlying() && this.fallFlyTicks == 0) {
+                return;
+            }
+            // DeerFolia end - Lithium: skip glide equipment checks for grounded entities
