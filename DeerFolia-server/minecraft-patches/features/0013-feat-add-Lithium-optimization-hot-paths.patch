+++ b/net/minecraft/world/level/EntityBasedExplosionDamageCalculator.java
@@ -17,6 +17,22 @@ public class EntityBasedExplosionDamageCalculator extends ExplosionDamageCalcula
     public Optional<Float> getBlockExplosionResistance(
         final Explosion explosion, final BlockGetter level, final BlockPos pos, final BlockState block, final FluidState fluid
     ) {
+        // DeerFolia start - Lithium: avoid lambda and Optional allocation in explosion raycasts
+        if (cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.enabled
+            && cn.lunadeer.mc.deerfolia.DeerFoliaConfiguration.lithiumOptimize.allocations) {
+            Optional<Float> resistance = super.getBlockExplosionResistance(explosion, level, pos, block, fluid);
+            if (resistance.isPresent()) {
+                float originalResistance = resistance.get();
+                float effectiveResistance = this.source.getBlockExplosionResistance(
+                    explosion, level, pos, block, fluid, originalResistance
+                );
+                if (effectiveResistance != originalResistance) {
+                    return Optional.of(effectiveResistance);
+                }
+            }
+            return resistance;
+        }
+        // DeerFolia end - Lithium: avoid lambda and Optional allocation in explosion raycasts
         return super.getBlockExplosionResistance(explosion, level, pos, block, fluid)
             .map(resistance -> this.source.getBlockExplosionResistance(explosion, level, pos, block, fluid, resistance));
     }
