+    // DeerFolia start - Lithium: depth-first passenger collection without stream allocations
+    private static void collectIndirectPassengersDepthFirst(final List<Entity> into, final List<Entity> from) {
+        for (final Entity passenger : from) {
+            collectIndirectPassengersDepthFirst(into, ((Entity)(Object)passenger).passengers);
